{
  "name": "howitworks",
  "version": "0.2.0",
  "description": "An interactive engineering-drawing skill for Claude Code that explains mechanisms and software concepts through physical cutaways and live simulations.",
  "keywords": [
    "howitworks",
    "claude-code",
    "claude",
    "skill",
    "agent-skill",
    "blueprint",
    "technical-drawing",
    "svg",
    "engineering",
    "explainer",
    "interactive"
  ],
  "license": "MIT",
  "author": "hariFED",
  "type": "module",
  "homepage": "https://harifed.github.io/howitworks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hariFED/howitworks.git"
  },
  "bugs": "https://github.com/hariFED/howitworks/issues",
  "bin": {
    "howitworks": "bin/install.mjs"
  },
  "exports": {
    "./kit/draft": "./kit/draft.mjs",
    "./kit/live": "./kit/live.mjs",
    "./kit/page": "./kit/page.mjs",
    "./kit/selfcheck": "./kit/selfcheck.mjs",
    "./kit/sheet.css": "./kit/sheet.css",
    "./kit/sheet3d.css": "./kit/sheet3d.css",
    "./kit/solid3d": "./kit/solid3d.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "kit/",
    "scripts/",
    "references/",
    "examples/**/*.mjs",
    "examples/**/*.js",
    "examples/**/meta.json",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "check": "node scripts/check-all.mjs",
    "check3d": "node scripts/check3d.mjs --all",
    "site": "node site/build.mjs"
  }
}
